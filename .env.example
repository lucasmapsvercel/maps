# Set in Vercel > Project > Settings > Environment Variables (Production).
# For local development, copy privately to .env.local and use a separate database.
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
AUTH_ALLOWED_EMAILS=
PORTAL_WORKSPACE_ID=maps
MONGODB_DB_NAME=MAPS
MONGODB_URI=
GOOGLE_COLLECTION_ENABLED=false

# Production NEXTAUTH_URL=https://maps-ten-ruddy.vercel.app
# Use the current private Atlas URI, including authentication and TLS options.
# Never reuse exposed credentials or use NEXT_PUBLIC_ for secrets.
