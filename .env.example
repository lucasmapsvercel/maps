# Copy privately to .env; never commit secrets.
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
AUTH_ALLOWED_EMAILS=
PORTAL_WORKSPACE_ID=maps
MONGODB_DB_NAME=MAPS
PORTAL_BIND_ADDRESS=127.0.0.1
PORTAL_PORT=3000
GOOGLE_COLLECTION_ENABLED=false

# Docker mounts these secrets from .secrets (npm run setup:docker).
# For Node without Docker, configure private values OR *_FILE paths:
# NEXTAUTH_SECRET_FILE=.secrets/nextauth-secret.txt
# GOOGLE_CLIENT_SECRET_FILE=.secrets/google-client-secret.txt
# MONGODB_URI=<private connection string with replicaSet and authentication>
# Do not use the exposed Atlas credential. Never use NEXT_PUBLIC_ for secrets.
